# Cloudflare API — read-only access to KV so we pull the same users/rules the
# CF Worker knows about. Get from https://dash.cloudflare.com/profile/api-tokens
# (create a token with "Workers KV Storage:Read" permission).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Telegram — same bot as the CF Worker uses, so notifications land in the same
# chat threads. Get the bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Optional: only race for these chatIds (comma-separated). If empty, races
# for every user in index:users. Handy for testing with a single user.
ONLY_CHAT_IDS=

# Optional: prefix every Telegram notification so we know which side fired.
# Default: [local] — matches worker.js output like "🏁 [race] BOOKED".
NOTIFY_TAG=local
